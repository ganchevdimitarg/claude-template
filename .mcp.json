{
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    },
    "github": {
      "type": "url",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "code-review-graph": {
      "type": "stdio",
      "command": "code-review-graph",
      "args": ["serve", "--auto-watch"]
    }
  }
}
